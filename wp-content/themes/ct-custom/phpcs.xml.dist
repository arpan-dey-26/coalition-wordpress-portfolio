<?xml version="1.0"?>
<ruleset name="WordPress Theme Coding Standards">
	<description>A custom set of code standard rules to check for WordPress themes.</description>
	<arg value="ps"/>
	<arg name="basepath" value="./"/>
	<arg name="parallel" value="8"/>
	<arg name="extensions" value="php,css,scss/css"/>
	<file>.</file>
	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.I18n">
		<properties><property name="text_domain" type="array" value="ct-custom"/></properties>
	</rule>
	<rule ref="WordPress.Files.FileName">
		<properties><property name="is_theme" value="true"/></properties>
	</rule>
	<config name="minimum_supported_wp_version" value="6.7"/>
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibility"/>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties><property name="prefixes" type="array" value="ct_custom"/></properties>
	</rule>
</ruleset>